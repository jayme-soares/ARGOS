# Copie para .env e preencha. NUNCA versione o .env.

# --- eOrder (obrigatório) ---
EORDER_USER=ENELINT\BR0000000000
EORDER_PASS=

# --- Push (ntfy) ---
NTFY_SERVER=https://ntfy.sh
# Tópico novo do ARGOS, com sufixo aleatório (quem souber o nome recebe os avisos)
NTFY_TOPIC=argos-religas-marica-TROQUE-ESTE-SUFIXO
# Link aberto ao tocar na notificação
ARGOS_PAINEL_URL=https://seu-projeto.vercel.app

# --- Push pelo painel (Web Push), em paralelo ao ntfy ---
# Mesmos valores do Vercel (Project Settings → API do Supabase)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
# Texto aleatório longo; o hash dele vai para public.argos_push_config (ver 002_argos_push.sql)
ARGOS_PUSH_CHAVE=
# Gerada com: python -m argos.webpush
ARGOS_VAPID_CHAVE_PRIVADA=
ARGOS_VAPID_CONTATO=mailto:seu-email@empresa.com

# --- Avisos às equipes de campo (painel /equipe; usa o mesmo Supabase/VAPID acima) ---
# Designação, vencimento e vencida só para a equipe da ordem, com confirmação obrigatória
ARGOS_AVISOS_EQUIPE=1
# Reenvio do push enquanto a equipe não confirma
ARGOS_REENVIO_AVISO_MIN=10

# --- Upstash Redis (ponte com o painel no Vercel) ---
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Em campo (Busca TdC) ---
ARGOS_FILTRO_CAMPO=PARCIAL RELIGA CENEGED - MARICÁ
# Só entram no painel/alertas as ordens deste município e das equipes com este prefixo
# (o município também filtra as Programáveis, pelo fim do endereço)
ARGOS_MUNICIPIO_CAMPO=MARICÁ
ARGOS_PREFIXO_EQUIPE_CAMPO=NI2
# Valores de "Estado TdC" que contam como finalizada (o filtro salvo precisa incluí-los).
# Para ver os estados reais: python -m argos.planilha <planilha exportada>
ARGOS_ESTADOS_FINALIZADOS=Finalizado,Encerrado,Concluído
ARGOS_INTERVALO_CAMPO_MIN=30
ARGOS_CAMPO_DIAS_ATRAS=7
# IDs dos inputs "Data de lançamento" (início/fim) na tela da Busca TdC
ARGOS_ID_DATA_LANC_INICIO=698246
ARGOS_ID_DATA_LANC_FIM=698247

# --- Contratos (SOC e Negociação; ver README, "Contratos") ---
# CO da SOC no combo da Busca TdC
ARGOS_SOC_CO_CAMPO=Valtellina - Niterói
# Liga a Negociação (COs "Ceneged - X"). Antes, rode a descoberta: python -m argos.eorder.descobrir
ARGOS_NEGOCIACAO=0
# Programáveis: value_do_CO:value_da_busca_salva:nome, separados por ";" (valores do descoberta.json).
# Buscas gerais de religa de cada CO (descoberta de 14/10/2026):
ARGOS_NEG_PROGRAMAVEIS=654:43404:Ceneged - Angra (CENEGED_ANGRA);192:37364:Ceneged - Araruama (CENEGED_ARARUAMA);193:44644:Ceneged - Cabo Frio (CENEGED_CABO_FRIO);194:39904:Ceneged - Campos (CENEGED_CAMPOS);198:40084:Ceneged - Cantagalo (CENEGED_CANTAGALO);196:46244:Ceneged - Itaperuna (CENEGED_ITAPERUNA);195:44624:Ceneged - Macaé (CENEGED_MACAE);652:75604:Ceneged - Niterói (CENEGED_NITEROI);197:40085:Ceneged - Pádua (CENEGED_PADUA);292:43544:Ceneged - R.Ostras (CENEGED_RIO_OSTRAS);653:43405:Ceneged - Petrópolis (CENEGED_PETROPOLIS
# Busca TdC: texto exato dos COs, separados por ";". Vazio = os 11 "Ceneged - X"
ARGOS_NEG_COS_CAMPO=
# Tópico ntfy da gestão da Negociação (opcional; o Web Push do painel já separa por contrato)
NTFY_TOPIC_NEGOCIACAO=

# --- Alertas ---
# Antecedências dos avisos "vai vencer", em minutos
ARGOS_ALERTAS_MIN=120,60,30,15
ARGOS_LEMBRETE_VENCIDAS_MIN=60
ARGOS_REAVALIACAO_ALERTAS_MIN=5

# --- Programáveis ---
ARGOS_INTERVALO_PROGRAMAVEIS_SEG=60
ARGOS_DIAS_UTEIS_PRAZO=2

# --- Janela de funcionamento (horário de Brasília) ---
ARGOS_HORARIO_INICIO=7
ARGOS_HORARIO_FIM=20
# 0=seg ... 6=dom
ARGOS_DIAS_SEMANA=0,1,2,3,4

# --- Chrome / robustez ---
ARGOS_HEADLESS=1
ARGOS_CHROME_BAIXA_MEMORIA=1
# 1 se o eOrder derrubar uma sessão quando o mesmo usuário loga em outra
ARGOS_MODO_SEQUENCIAL=0
